# Backblaze B2 credentials for the bucket-restricted application key.
# Use the Application Key ID and Application Key secret, not the bucket ID.
B2_KEY_ID=
B2_APP_KEY=

# Enter the exact unique Bucket Name shown under B2 Cloud Storage > Buckets.
# Do not enter the 24-character hexadecimal Bucket ID.
B2_BUCKET=your-private-bucket-name

# Region copied from the bucket's S3 endpoint,
# for example: us-west-004, us-east-005 or eu-central-003.
B2_REGION=us-east-005
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com

# Optional B2 root for source documents, derived text and review records.
EVIDENCECAST_B2_PREFIX=evidencecast

# For S3-compatible SDK access, a bucket-restricted key should have
# Read and Write access and "Allow List All Bucket Names" enabled.

# GMI Cloud provider.
IMAGE_PROVIDER=gmicloud
GMI_API_KEY=

# NVIDIA hosted NIM provider. The hosted key normally begins with nvapi-.
# Keep the key only in the populated local .env or deployment secret manager.
NVIDIA_API_KEY=
NVIDIA_IMAGE_MODEL=stabilityai/stable-diffusion-3-5-large
NVIDIA_AUDIO_MODEL=nvidia/magpie-tts-multilingual
NVIDIA_TTS_VOICE=Magpie-Multilingual.EN-US.Aria
NVIDIA_TTS_ENDPOINT=https://877104f7-e885-42b9-8de8-f6e4c6303969.invocation.api.nvcf.nvidia.com/v1/audio/synthesize

# Optional fallback. OpenAI API billing is separate from ChatGPT subscriptions.
OPENAI_API_KEY=

# Deployment and judge-fixture settings.
EVIDENCECAST_FIXTURE_MODE=1
EVIDENCECAST_API_URL=http://localhost:8000
EVIDENCECAST_ALLOWED_ORIGINS=*

# Set to 1 on small public instances to disable Pillow, eSpeak and FFmpeg assembly controls.
# Keep 0 for local development or adequately provisioned private deployments.
EVIDENCECAST_DISABLE_HEAVY_ASSEMBLY=0
