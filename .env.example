# Backblaze B2 credentials for the bucket-restricted application key.
# Use the Application Key ID and Application Key secret, not the bucket ID.
B2_KEY_ID=
B2_APP_KEY=

# Enter the exact unique Bucket Name shown under B2 Cloud Storage > Buckets.
# Do not enter the 24-character hexadecimal Bucket ID.
B2_BUCKET=your-private-bucket-name

# Optional region hint copied from the bucket's S3 endpoint,
# for example: us-west-004, us-east-005 or eu-central-003.
B2_REGION=

# For S3-compatible SDK access, a bucket-restricted key should have
# Read and Write access and "Allow List All Bucket Names" enabled.

# GMI Cloud provider credential for image generation.
GMI_API_KEY=
